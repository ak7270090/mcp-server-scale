# Run B: four Uvicorn workers in one container (start with MCP_WORKER_COUNT=4).
# Use with: $env:HARNESS_ENV_FILE="../02-streamable-http-single/harness/four-workers.env"
# Affinity and distribution fail on every run. Single-call suites (conformance, elicitation,
# resumability) pass or fail depending on which worker each connection lands on, so they are
# skipped here to keep the run repeatable.
HARNESS_TARGET_URL=http://localhost:8000/mcp
HARNESS_EXPECTED_REPLICA_COUNT=4
HARNESS_SKIPPED_SUITES=["failover", "conformance", "elicitation", "resumability"]
HARNESS_EXPECTED_FAILURES=["affinity", "distribution"]
HARNESS_REQUEST_TIMEOUT_SECONDS=5
HARNESS_RESULTS_DIR=../02-streamable-http-single/results/four-workers
