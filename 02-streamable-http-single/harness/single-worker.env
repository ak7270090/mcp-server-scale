# Run A: one Uvicorn worker. Use with: $env:HARNESS_ENV_FILE="../02-streamable-http-single/harness/single-worker.env"
HARNESS_TARGET_URL=http://localhost:8000/mcp
HARNESS_EXPECTED_REPLICA_COUNT=1
HARNESS_SKIPPED_SUITES=["failover"]
HARNESS_EXPECTED_FAILURES=[]
HARNESS_RESULTS_DIR=../02-streamable-http-single/results/single-worker
