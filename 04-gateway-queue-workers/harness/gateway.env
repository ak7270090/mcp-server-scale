# Gateway + 3 workers (WORKER_REPLICAS=3, no autoscaler).
# Use with: $env:HARNESS_ENV_FILE="../04-gateway-queue-workers/harness/gateway.env"
# Calls go to whichever worker is free, so "pinning" is expected to fail while the
# counter (affinity) survives because it lives in the NATS key-value bucket.
HARNESS_TARGET_URL=http://localhost:8000/mcp
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=[]
HARNESS_EXPECTED_FAILURES=["pinning"]
HARNESS_AFFINITY_CALL_COUNT=1000
HARNESS_KILL_COMMAND=docker kill {replica}
HARNESS_RESTORE_COMMAND=docker start {replica}
HARNESS_RESULTS_DIR=../04-gateway-queue-workers/results/harness
