# Worker containers Compose creates (set to the autoscaler maximum with --profile autoscale)
WORKER_REPLICAS=3
# worker_waits (variant A) or continuation (variant B)
MCP_ELICITATION_MODE=continuation
# Seconds without a heartbeat before JetStream redelivers a job
MCP_JOB_ACK_WAIT_SECONDS=5
MCP_JOB_MAX_DELIVERIES=3
# Jobs allowed in the queue before the gateway rejects new calls
MCP_QUEUE_MAX_PENDING=1000
MCP_JOB_MESSAGE_TIMEOUT_SECONDS=60
MCP_MIN_WORKERS=1
MCP_MAX_WORKERS=10
MCP_TARGET_JOBS_PER_WORKER=2
MCP_SCALE_DOWN_COOLDOWN_SECONDS=20
MCP_LOG_LEVEL=INFO
