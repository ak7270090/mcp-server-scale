# Variant A: HAProxy cookie stickiness.
# Use with: $env:HARNESS_ENV_FILE="../03-sticky-session-lb/harness/cookie-haproxy.env"
HARNESS_TARGET_URL=http://localhost:8081/mcp
HARNESS_EXPECTED_REPLICA_COUNT=3
HARNESS_SKIPPED_SUITES=[]
HARNESS_EXPECTED_FAILURES=["failover"]
HARNESS_AFFINITY_CALL_COUNT=1000
HARNESS_KILL_COMMAND=docker kill {replica}
HARNESS_RESTORE_COMMAND=docker start {replica}
HARNESS_RESULTS_DIR=../03-sticky-session-lb/results/cookie-haproxy
