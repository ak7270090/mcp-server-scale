# The API gateway serves backend tools, not the standard tool set, so only the protocol checks
# of the conformance suite apply. Run from test-harness/:
#   $env:HARNESS_ENV_FILE="../05-api-to-mcp-gateway/harness/gateway.env"
#   .\.venv\Scripts\python.exe -m pytest tests/suites/test_conformance.py -k rejects
HARNESS_TARGET_URL=http://localhost:8000/mcp
HARNESS_SKIPPED_SUITES=["distribution", "affinity", "pinning", "failover", "resumability", "elicitation"]
HARNESS_EXPECTED_FAILURES=[]
HARNESS_RESULTS_DIR=../05-api-to-mcp-gateway/results/harness
