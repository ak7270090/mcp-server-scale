# Seconds between re-crawling the backends and re-reading config/tool_overrides.yaml
MCP_REGISTRY_REFRESH_SECONDS=5
# true: expose only search_tools / get_tool_schema / invoke_tool (many-tools mode)
MCP_IS_DISCOVERY_MODE=false
MCP_READ_ONLY_RETRY_ATTEMPTS=2
MCP_HTTP_TIMEOUT_SECONDS=10
MCP_GRPC_TIMEOUT_SECONDS=10
MCP_LOG_LEVEL=INFO
